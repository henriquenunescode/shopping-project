
generator client {
  output   = "../src/generated/prisma"
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

// -------------------------------------------
// Usuários do sistema
// -------------------------------------------
model users {
  user_id   Int     @id @default(autoincrement())
  nome      String  @db.VarChar(30)
  email     String  @unique @db.VarChar(30)
  senha     String  @db.VarChar(100)
  google_id String? @unique @db.VarChar(100)

  // Relações
  orders  orders[]
  tickets tickets[]
  rentals rentals[]

  @@map("users")
}

// -------------------------------------------
// Filmes disponíveis
// -------------------------------------------
model movies {
  movies_id Int      @id @default(autoincrement())
  titulo    String   @db.VarChar(40)
  genero    String   @db.VarChar(30)
  duracao   Int

  // Relações
  tickets tickets[]
  rentals rentals[]

  @@map("movies")
}

// -------------------------------------------
// Lojas
// -------------------------------------------
model stores {
  store_id Int    @id @default(autoincrement())
  nome     String @db.VarChar(40)
  tipo     String @db.VarChar(40)

  // Relações
  products products[]
  workers  workers[]

  @@map("stores")
}

// -------------------------------------------
// Produtos vinculados a lojas
// -------------------------------------------
model products {
  product_id Int     @id @default(autoincrement())
  store_fk   Int
  nome       String  @db.VarChar(50)
  preco      Decimal @db.Decimal(6, 2)
  estoque    Int

  // Relações
  store stores @relation(fields: [store_fk], references: [store_id])
  items order_items[]
  
  @@map("products")
}

// -------------------------------------------
// Funcionários vinculados a lojas
// -------------------------------------------
model workers {
  worker_id Int    @id @default(autoincrement())
  nome      String @db.VarChar(50)
  tipo      String @db.VarChar(50)
  store_fk  Int

  // Relações
  store stores @relation(fields: [store_fk], references: [store_id])

  @@map("workers")
}

// -------------------------------------------
// Pedidos de usuários
// -------------------------------------------
model orders {
  orders_id Int     @id @default(autoincrement())
  user_fk   Int
  total     Decimal @db.Decimal(6, 2)

 
  user users @relation(fields: [user_fk], references: [user_id])

  @@map("orders")
}

// -------------------------------------------
// Itens de cada pedido - Entidade Para Auxiliacao(N:N)
// -------------------------------------------
model order_items {
  item_id        Int     @id @default(autoincrement())
  order_fk       Int
  product_fk     Int
  quantidade     Int
  preco_unitario Decimal @db.Decimal(6, 2)  // preço no momento da compra, para a eventual mudança

  order   orders   @relation(fields: [order_fk],   references: [orders_id])
  product products @relation(fields: [product_fk], references: [product_id])

  @@map("order_items")
}


// -------------------------------------------
// Ingressos de sessões de cinema
// -------------------------------------------
model tickets {
  tickets_id Int    @id @default(autoincrement())
  user_fk    Int
  movie_fk   Int
  sessao     String @db.VarChar(5)

  user  users?  @relation(fields: [user_fk], references: [user_id])
  movie movies? @relation(fields: [movie_fk], references: [movies_id])

  @@map("tickets")
}

// -------------------------------------------
// Aluguéis de filmes
// -------------------------------------------
model rentals {
  rental_id  Int      @id @default(autoincrement())
  user_fk     Int
  movie_fk    Int
  data_final DateTime @db.Date

  user  users  @relation(fields: [user_fk], references: [user_id])
  movie movies @relation(fields: [movie_fk], references: [movies_id])

  @@map("rentals")
}
