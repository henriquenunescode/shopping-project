+}
+
+/* HOTFIX: regras diretas para garantir layout mesmo se o nesting do CSS falhar */
+#main-content {
+    padding: 0 24px 40px;
+}
+
+#view-products,
+#section-funcionarios {
+    width: 100%;
+    padding: 32px 0;
+}
+
+#view-products > .title-section,
+#section-funcionarios > .title-section {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-bottom: 24px;
+}
+
+#view-products > .title-section h2,
+#section-funcionarios > .title-section h2 {
+    font-family: "Sparkle Passion";
+    font-size: 42px;
+    font-weight: 400;
+    color: #2c365a;
+}
+
+#view-products > .title-section button,
+#section-funcionarios > .title-section button {
+    width: 220px;
+    padding: 12px;
+    border: none;
+    border-radius: 6px;
+    background-color: #2c365a;
+    color: #fff;
+    font-weight: 700;
+    cursor: pointer;
+}
+
+#view-products .grid-products {
+    margin-top: 24px;
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 24px;
+}
+
+#view-products .grid-products > .product {
+    width: 300px;
+    max-width: 300px;
+    display: flex;
+    flex-direction: column;
+    overflow: hidden;
+    background-color: #fff;
+    border-radius: 10px;
+    border-bottom: 4px solid #2c365a;
+    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
+    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+}
+
+#view-products .grid-products > .product > img {
+    width: 100%;
+    height: 200px;
+    object-fit: cover;
+}
+
+#view-products .grid-products .info-product {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+    padding: 12px 20px;
+}
+
+#view-products .grid-products .info-product h3 {
+    font-size: 20px;
+    font-weight: 600;
+}
+
+#view-products .grid-products .info-product .price {
+    font-size: 20px;
+    text-decoration: underline;
+}
+
+#view-products .grid-products select {
+    width: calc(100% - 40px);
+    height: 35px;
+    margin: 10px 20px 0;
+    padding: 5px;
+}
+
+#view-products .grid-products .buttons {
+    display: flex;
+    justify-content: space-around;
+    gap: 10px;
+    padding: 12px;
+}
+
+#view-products .grid-products .buttons .add {
+    flex: 1;
+    padding: 10px;
+    border-radius: 10px;
+    border: 1px solid #05102d;
+    background-color: #05102d;
+    color: #fff;
+    font-weight: 600;
+    cursor: pointer;
+}
+
+#section-funcionarios .grid-funcionarios {
+    display: flex;
+    flex-direction: column;
+    gap: 20px;
+}
+
+#section-funcionarios .funcionario {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 20px;
+    background-color: #fff;
+    border-left: 4px solid #05102d;
+    border-radius: 0 10px 10px 0;
+    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
+}
+
+.cart-products.active {
+    right: 0 !important;
+}
